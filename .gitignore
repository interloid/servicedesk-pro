# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.e2e/
/.next-e2e/
/screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit secrets. Copy .env.example to .env.local instead.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design previews (not shipped)
/design-previews/

# Claude Code local settings and installed third-party agent skills
.claude/


# Lock file written by `npx skills add`
skills-lock.json

# Test folders at any level, including supabase/tests
tests
# ...except the authorization suite, which npm run test:authz runs.
!supabase/tests/
.env*

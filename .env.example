NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_NAME=ServiceDesk
NEXT_PUBLIC_SITE_DESCRIPTION=Customer support and help desk management platform
NEXT_PUBLIC_TWITTER_HANDLE=@servicedesk
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-here
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_SENTRY_DSN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails of the people allowed into /platform (the platform
# console). They sign in through their workspace as usual, then open /platform.
PLATFORM_ADMIN_EMAILS=

# Reads Supabase logs for /platform/logs and the API traffic on /platform/health.
# Server-only. Create a scoped token limited to this project with only the
# Logs (Read) permission: https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=  
# Only needed when NEXT_PUBLIC_SUPABASE_URL is a custom domain.
SUPABASE_PROJECT_REF=

# Team invitations to people who already have an account are sent by the app
# through Resend (Supabase can only send its invite email to new accounts).
# FROM_EMAIL must be on a domain verified in Resend,
# e.g. ServiceDesk <team@foxyblog.app>
RESEND_API_KEY=
FROM_EMAIL=

NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# "true" only if PayPal has enabled card fields for subscriptions on this
# merchant. Otherwise the card option uses PayPal's hosted card page.
NEXT_PUBLIC_PAYPAL_CARD_FIELDS=
# Comma-separated domains the PayPal client token is bound to (server-side,
# Edge Function env). PayPal rejects bare hosts like localhost, so leave it
# empty in local development.
PAYPAL_TOKEN_DOMAINS=

AUTH_COOKIE_DOMAIN=.localhost
PORTAL_BASE_DOMAIN=localhost:3000
SUBDOMAIN_ROUTING_AVAILABLE=true

# Shared secret for the reconcile-subscriptions cron; generate with the same
# command as SESSION_SECRET above.
CRON_SECRET=your-cron-secret-here

# Argos project token, for npm run test:visual
ARGOS_TOKEN=

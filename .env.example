# =============================================================================
# Environment variables: template
#
# Local:        cp .env.example .env.local   (.env.local is git-ignored)
# Development:  GitHub → Settings → Environments → development
# Production:   GitHub → Settings → Environments → production
# Each deploy copies groups 2-6 to Vercel and group 7 to the Supabase project's
# Edge Function secrets (scripts/ci/sync-env.mjs); don't edit them there.
# EMAIL_ALLOWED_RECIPIENTS (group 7) goes to both.
# Full guide: docs/deployment.md
#
# [public]  compiled into the browser bundle; safe to expose, but set per environment
# [secret]  server-only; never prefix with NEXT_PUBLIC_, never commit a real value
# Real values live in the team password manager, one vault per environment.
# =============================================================================


# ── 1. Runtime ───────────────────────────────────────────────────────────────
# Next.js sets this itself for builds; keep "development" locally.
NODE_ENV=development


# ── 2. Site [public] ─────────────────────────────────────────────────────────
# Full origin of the app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Host (and port) workspaces live under. On a real domain, {slug}.<domain>
# subdomains and shared sign-in cookies switch on automatically; they stay off
# for localhost, *.vercel.app and IP addresses.
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_NAME=ServiceDesk
NEXT_PUBLIC_SITE_DESCRIPTION=Customer support and help desk management platform
# Optional. Starts with @.
NEXT_PUBLIC_TWITTER_HANDLE=


# ── 3. Supabase ──────────────────────────────────────────────────────────────
# Local values are printed by `supabase start`.
# [public]
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [secret] Bypasses row-level security. Server-only.
SUPABASE_SERVICE_ROLE_KEY=


# ── 4. Platform console (/platform) ──────────────────────────────────────────
# Comma-separated emails allowed into the platform console. Use real admin
# logins, never a seeded demo account.
PLATFORM_ADMIN_EMAILS=
# [secret] Optional. Reads Supabase logs for /platform/logs and /platform/health.
# Create a token limited to this project with only Logs (Read):
# https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=
# Optional. Only when NEXT_PUBLIC_SUPABASE_URL is a custom domain.
SUPABASE_PROJECT_REF=


# ── 5. Payments: app side [public] ───────────────────────────────────────────
# PayPal client ID (sandbox for local and development, live for production).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=


# ── 6. Monitoring: Sentry ────────────────────────────────────────────────────
# Leave empty locally to send nothing. Development and production report to
# separate environments automatically (from VERCEL_ENV).
# [public]
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only, for uploading source maps.
SENTRY_ORG=
SENTRY_PROJECT=
# [secret]
SENTRY_AUTH_TOKEN=


# ── 7. Edge Functions ────────────────────────────────────────────────────────
# Not read by Next.js. Locally: supabase functions serve --env-file .env.local
# Hosted: set in the GitHub environment; each deploy copies them to Supabase.
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# to functions itself.
#
# PayPal API. Sandbox: https://api-m.sandbox.paypal.com  Live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
# [secret]
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered for paypal-webhook; verifies its signatures.
PAYPAL_WEBHOOK_ID=
# Gmail API sending. Use a test account everywhere except production.
GOOGLE_CLIENT_ID=
# [secret]
GOOGLE_CLIENT_SECRET=
# [secret] Needs the gmail.send scope.
GOOGLE_REFRESH_TOKEN=
# Must belong to the Google account above, e.g. ServiceDesk <support@example.com>
FROM_EMAIL=
# App origin used for links in emails.
FRONTEND_URL=http://localhost:3000
# Optional. Limits ALL outbound mail (invites, sign-in links, password resets,
# notifications, invoices) to these comma-separated addresses and @domains,
# e.g. "you@example.com, @example.org". Empty: anyone can be emailed. Set it
# for development and any public demo, so visitors can't use invites to email
# strangers. The app reads it too, to tell the inviter no email went out.
EMAIL_ALLOWED_RECIPIENTS=


# ── 8. Scripts and tests (local only) ────────────────────────────────────────
# Password for accounts created by scripts/seed-tenants.mjs.
SEED_PASSWORD=
# [secret] Argos project token, for npm run test:visual.
ARGOS_TOKEN=


# ── Local Supabase CLI (not this file) ───────────────────────────────────────
# Google sign-in on the local stack reads these from the shell that runs
# `supabase start`, not from this file:
#   export SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=...
#   export SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=...
